---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { config } from '@/site-config'
---

<BaseLayout title="About" description={`About ${config.site.author}`}>
  <div class="animate mx-auto max-w-3xl">
    <header class="not-prose mb-8 text-center">
      <h1 class="font-serif text-3xl font-semibold">About</h1>
      <p class="mt-3 text-ink-soft">{config.site.description}</p>
    </header>

    <div class="prose prose-fill">
      <h2>About me</h2>
      {
        config.home.hero.about
          .split(/\n\s*\n/)
          .filter(Boolean)
          .map((paragraph) => <p>{paragraph}</p>)
      }

      <h2>What I write about</h2>
      <p>
        Technology, language, work, and the parts of everyday life that are difficult to explain with
        code alone.
      </p>

      <h2>Contact</h2>
      <p>Email: <a href="mailto:blog@wen.moe">blog@wen.moe</a></p>
    </div>
  </div>
</BaseLayout>
