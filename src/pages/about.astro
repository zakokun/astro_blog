---
import Layout from '../layouts/Layout.astro';
import { SITE_DATA } from '../constants';

import '../styles/about.css';
---

<Layout pageTitle="About">
    <div class="page-container">
        <h1>About</h1>

        <div class="about-content">
            <section>
                <h2>{SITE_DATA.name}</h2>
                <p class="intro-text">
                    This is a personal blog for notes, projects, technical writing, and the occasional
                    unfinished thought that became useful enough to publish.
                </p>
            </section>

            <section>
                <h2>Contact</h2>
                <p>
                    Update this page in <code>src/pages/about.astro</code> when you are ready to add a
                    bio, links, or contact details.
                </p>
            </section>
        </div>
    </div>
</Layout>
