---
import siteConfig from "@config";
const currentYear = new Date().getFullYear();
---

<footer
  class="mx-4 my-8 flex max-w-5xl flex-col items-center justify-center rounded-xl border border-stone-200/70 bg-white/80 px-5 py-5 shadow-sm sm:mx-6 sm:px-8 sm:py-6 lg:mx-auto dark:border-gray-800 dark:bg-gray-900/80"
>
  <p class="text-center text-gray-600 dark:text-gray-400">
    © {currentYear}&nbsp;
    <a
      href={siteConfig.authorUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="font-semibold text-gray-800 hover:text-blue-500 hover:underline dark:text-gray-200 dark:hover:text-blue-400"
    >
      {siteConfig.author}
    </a>
    · All rights reserved.
  </p>
  <p>
    <a
      href="/rss.xml"
      target="_blank"
      class="text-gray-800 hover:text-blue-500 hover:underline dark:text-gray-400 dark:hover:text-blue-400"
      >RSS Feed</a
    >
    {" / "}
    <a
      href="/sitemap-index.xml"
      target="_blank"
      class="text-gray-800 hover:text-blue-500 hover:underline dark:text-gray-400 dark:hover:text-blue-400"
    >
      Sitemap
    </a>
  </p>
</footer>
